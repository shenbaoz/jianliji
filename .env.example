# Copy this file to .env on the server. Production startup rejects placeholders and unsafe values.
NODE_ENV=production
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3102

# Public site origin. Use the exact HTTPS domain in production, without a trailing slash.
CORS_ORIGIN=https://znhil.xyz

# Required for the separate admin page. Use a long random password, never the example value.
ADMIN_PASSWORD=replace_with_at_least_20_random_characters

# Set true on production so a broken MySQL connection never silently falls back to local files.
REQUIRE_MYSQL=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=znhil_resume
DB_USER=replace_me
DB_PASSWORD=replace_me
DB_CHARSET=utf8mb4

UPLOAD_MAX_AGE_HOURS=24
UPLOAD_CLEANUP_INTERVAL_MINUTES=60

# Keep this server-side only. Never put API keys in Vite variables or browser code.
DEEPSEEK_API_KEY=replace_with_a_server_side_key
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional fallback provider. It is used only if DeepSeek has a temporary failure.
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k

# Official ONLYOFFICE Document Server for editing uploaded DOCX/PDF files.
# Keep both secrets private and use a generated value of at least 32 characters.
ONLYOFFICE_PUBLIC_URL=https://znhil.xyz/onlyoffice/
ONLYOFFICE_JWT_SECRET=replace_with_a_random_32_character_or_longer_secret
ONLYOFFICE_CALLBACK_TOKEN=replace_with_a_different_random_32_character_or_longer_secret
